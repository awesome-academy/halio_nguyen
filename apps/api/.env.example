# API Specific Environment Configuration
APP_NAME=sun-booking-tours-api
APP_ENV=development
APP_PORT=8080
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_USER=sun_booking
POSTGRES_PASSWORD=sun_booking_secret
POSTGRES_DB=sun_booking_tours
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://sun_booking:sun_booking_secret@localhost:5434/sun_booking_tours?sslmode=disable

# JWT Auth
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ACCESS_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# Bank Data Encryption (AES-256 Key)
BANK_ENCRYPTION_KEY=my-super-secret-encryption-key32b

# OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/v1/auth/facebook/callback

TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://localhost:8080/api/v1/auth/twitter/callback

# VNPay / Internet Banking
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/callback
