# ==============================================================================
# SUN Booking Tours — Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# App Configuration
APP_NAME=sun-booking-tours
APP_ENV=development
APP_PORT=8080
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Database (Docker & Local)
POSTGRES_USER=sun_booking
POSTGRES_PASSWORD=sun_booking_secret
POSTGRES_DB=sun_booking_tours
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://sun_booking:sun_booking_secret@localhost:5434/sun_booking_tours?sslmode=disable

# pgAdmin 4
PGADMIN_EMAIL=admin@sunbooking.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ACCESS_EXPIRY_HOURS=1
JWT_REFRESH_EXPIRY_DAYS=7

# Bank Data Encryption (AES-256 Key - 32 bytes hex or passphrase)
BANK_ENCRYPTION_KEY=my-super-secret-encryption-key32b

# Admin Portal Security
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_BURST=5
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# OAuth 2.0 Providers
# Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/v1/auth/facebook/callback

# Twitter / X
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://localhost:8080/api/v1/auth/twitter/callback

# Payment Gateway (VNPay / Internet Banking Sandbox)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/callback

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
